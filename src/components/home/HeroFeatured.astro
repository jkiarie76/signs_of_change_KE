---
import FeaturedSidebar from "./FeaturedSidebar.astro";
---
<section class="hero-featured">

    <div class="container">

        <div class="hero-grid">

            <!-- LEFT COLUMN -->

            <article class="hero-main">

                <div class="section-header">
                   
                    <h3>This week's read</h3>

                </div>

                <div class="hero-image">

                    <img
                        src="/uploads/home/hero.jpg"
                        alt="Featured Story"
                    />

                </div>

                <div class="hero-content">

                    <div class="hero-tags">

                        <span class="hero-category">

                            Deaf Culture 101

                        </span>

                        <span class="hero-featured-badge">

                            ★ Featured

                        </span>

                    </div>

                    <h1>

                        Bridging the gap between the Deaf and Hearing Communities Through Stories

                    </h1>

                    <div class="hero-meta">

                        <span>

                            <i class="fa-solid fa-user"></i>

                            By Admin

                        </span>

                        <span>

                            <i class="fa-regular fa-calendar"></i>

                            Aug 3, 2026

                        </span>

                        <span>

                            <i class="fa-regular fa-clock"></i>

                            5 min read

                        </span>

                    </div>

                    <p>

                        Discover inspiring stories, practical sign language lessons,
                        Deaf culture insights and community initiatives happening
                        across Kenya.

                    </p>

                    <a href="#" class="btn-primary">

                        Read Featured Story

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                    <div class="hero-explore">

                        <p class="hero-explore-title">

                            Explore More

                        </p>

                        <div class="hero-explore-links">

                            <a href="/learn-sign">

                                🤟 Learn Sign

                            </a>

                            <a href="/deaf-culture">

                                📖 Deaf Culture

                            </a>

                            <a href="/deaf-world">

                                🌍 Deaf World

                            </a>

                        </div>

                    </div>

                </div>

            </article>

            <FeaturedSidebar />

        </div>

    </div>

</section>