---
import { getCollection } from "astro:content";

const etiquetteGuidelines = await getCollection("etiquette");

const categories = [
    ...new Set(
        etiquetteGuidelines.map(
            (item) => item.data.category
        )
    ),
];

const formatCategoryLabel = (category: string) =>
    category
        .split("-")
        .map(
            (word) =>
                word.charAt(0).toUpperCase() +
                word.slice(1)
        )
        .join(" ");

const filters = [
    {
        label: "All Guidance",
        value: "all",
    },
    ...categories.map((category) => ({
        label: formatCategoryLabel(category),
        value: category,
    })),
];
---

<section class="collection-filters">

    <div class="container">

        <h2 class="filters-title">

            Browse by Situation

        </h2>

        <div
            class="filters-wrapper"
            data-filter-group
            data-target=".etiquette-page-grid"
        >   

            <div class="filters-grid">

                {

                    filters.map((filter, index) => (

                        <button
                            class={`filter-chip ${index === 0 ? "active" : ""}`}
                            data-filter={filter.value}
                        >

                            {filter.label}

                        </button>

                    ))

                }

            </div>

        </div>

    </div>

</section>