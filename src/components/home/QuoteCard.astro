---
interface Props{

    quote:string;

    author:string;

}

const{

    quote,

    author

}=Astro.props;
---

<article class="homepage-quote-card">

    <div class="quote-header">

        <span class="quote-icon">✨</span>

        <span class="quote-title">

            Quote of the Week

        </span>

    </div>

    <div class="quote-body">

        <span class="quote-mark">“</span>

        <p>

            {quote}

        </p>

    </div>

    <footer class="quote-author">

        — {author}

    </footer>

</article>