---

import QuoteCard from "./QuoteCard.astro";
import SignOfTheWeekCard from "./SignOfTheWeekCard.astro";
import NewsLetterCard from "./NewsLetterCard.astro";

import HomepageMythCard from "./HomepageMythCard.astro";

---

<div class="featured-sidebar">

    <HomepageMythCard

        category="Communication"

        myth="All Deaf people can read lips."

        fact="Only some Deaf people use lip-reading. Even skilled lip-readers usually understand only part of spoken conversation."

    />

    <QuoteCard

    quote="Sign language is not just a way to communicate. It is a way of belonging."

    author="Kenyan Deaf Community"

    />

    <SignOfTheWeekCard
    media="/uploads/home/olderpost_1.jpg"
    mediaType="image"
    sign="THANK YOU"
    description="One of the first signs every beginner should learn."
    difficulty="★ Easy"
    />

    <NewsLetterCard />

</div>