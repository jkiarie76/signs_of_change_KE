---
import AdvocacyCard from "../../components/shared/AdvocacyCard.astro";

import { getCollection } from "astro:content";

const advocacyItems = await getCollection("advocacy");

const latestAdvocacy = advocacyItems
    .filter((item) => item.data.published)
    .sort((a, b) => {
        const dateA = new Date(
            a.data.publishedDate
        ).getTime();

        const dateB = new Date(
            b.data.publishedDate
        ).getTime();

        return dateB - dateA;
    })
    .slice(0, 3);
---
<section
    id="advocacy"
    class="deafworld-advocacy-preview"
>

    <div class="container">

        <div class="section-header">

            <span class="eyebrow">
                ADVOCACY
            </span>

            <h2>
                The organizations doing the work
            </h2>

        </div>


        <p class="section-intro-text">

            Where to volunteer, donate and support organizations
            creating lasting change.

        </p>


        <div class="advocacy-grid">

            {
                latestAdvocacy.map((item) => (

                    <AdvocacyCard
                        initiative={item}
                        preview={true}
                    />

                ))
            }

        </div>


        <!-- EXPLORE ADVOCACY -->

        <div class="history-actions-wrapper">

            <a
                href="/deaf-world/advocacy"
                class="btn-explore-page"
            >

                Explore Advocacy →

            </a>

        </div>

    </div>

</section>