---
import { getCollection } from "astro:content";

const signItems = await getCollection("signs");

const publishedSigns = signItems.filter(
    (item) => item.data.published
);

const signsData = publishedSigns.map((item) => ({
    id: item.id,

    character: item.data.character,

    characterType: item.data.characterType,

    signLanguage: item.data.signLanguage,

    country: item.data.country ?? "",

    title: item.data.title,

    description: item.data.description,

    tips: item.data.tips,

    // media: item.data.media,
}));
---

<section id="alphabet-section" class="learn-sign-alphabet">

    <div class="container">

        <span class="eyebrow">
            01 · INTERACTIVE
        </span>

        <h2 class="section-heading">
            Alphabet & Numbers
        </h2>

        <p class="section-subtext">
            Tap any letter or number to see how the handshape is formed.
            This is fingerspelling — the backbone you fall back on for
            names, brands, and any word you don't yet know the sign for.
        </p>


        <div class="interactive-alphabet-grid">


            <!-- =========================================
                 LEFT — CHARACTER SELECTOR
                 ========================================= -->

            <div class="alphabet-selector">

                <!-- SIGN LANGUAGE SELECTOR -->

                <div class="language-selector">

                    <label for="sign-language-select">
                        Sign Language
                    </label>

                    <select
                        id="sign-language-select"
                        class="sign-language-select"
                    >
                        <!-- JavaScript populates languages -->
                    </select>

                </div>

                <!-- CHARACTER TYPE -->

                <div class="toggle-container">

                    <button
                        type="button"
                        id="toggle-az"
                        class="toggle-btn active"
                        data-character-mode="letters"
                    >
                        A–Z
                    </button>

                    <button
                        type="button"
                        id="toggle-09"
                        class="toggle-btn"
                        data-character-mode="numbers"
                    >
                        0–10
                    </button>

                </div>


                <div
                    id="character-buttons-grid"
                    class="buttons-layout-grid"
                >
                </div>

            </div>


            <!-- =========================================
                 RIGHT — SIGN PREVIEW
                 ========================================= -->

            <article
                class="preview-card"
                id="preview-card"
            >

                <span class="preview-eyebrow">
                    FINGERSPELLING
                </span>


                <div class="preview-display-row">

                    <div
                        class="preview-box-avatar"
                        id="preview-avatar"
                    >
                        A
                    </div>


                    <div class="preview-text-details">

                        <h3
                            class="preview-title"
                            id="preview-title"
                        >
                        </h3>

                        <p
                            class="preview-language"
                            id="preview-language"
                        >
                            
                        </p>

                        <p
                            class="preview-desc"
                            id="preview-desc"
                        >
                        </p>

                    </div>

                </div>




                <!-- SIGN MEDIA -->

                <div
                    class="preview-media"
                    id="preview-media"
                >
                </div>


                <ul
                    class="preview-tips-list"
                    id="preview-tips"
                >
                </ul>

                <div
                    class="preview-empty-state"
                    id="preview-empty-state"
                    hidden
                >

                    <div class="preview-box-avatar">
                        ?
                    </div>

                    <div class="preview-text-details">

                        <h3 class="preview-title">
                            Sign Coming Soon
                        </h3>

                        <p class="preview-desc">
                            Sign information for this character
                            has not been published yet.
                        </p>

                    </div>

                </div>

            </article>

        </div>

    </div>

</section>


<script define:vars={{ signsData }}>
    window.learnSignData = signsData;
</script>
