---
import { getCollection } from "astro:content";

import QuoteCard from "./QuoteCard.astro";
import SignOfTheWeekCard from "./SignOfTheWeekCard.astro";
import NewsLetterCard from "./NewsLetterCard.astro";
import HomepageMythCard from "./HomepageMythCard.astro";

const myths = await getCollection("myths");

const featuredMyth = myths
    .filter((myth) => myth.data.featured)
    .sort(
        (a, b) =>
            b.data.publishedDate.valueOf() -
            a.data.publishedDate.valueOf()
    )[0];

const quotes = await getCollection("quotes");

const featuredQuote = quotes
    .filter((quote) => quote.data.featured)
    .sort(
        (a, b) =>
            b.data.publishedDate.valueOf() -
            a.data.publishedDate.valueOf()
    )[0];

const videos = await getCollection("videos");

const featuredVideo = videos
    .filter((video) => video.data.featured)
    .sort(
        (a, b) =>
            b.data.publishedDate.valueOf() -
            a.data.publishedDate.valueOf()
    )[0];
---

<div class="featured-sidebar">

    {featuredMyth && (
        <HomepageMythCard
            category={featuredMyth.data.category}
            myth={featuredMyth.data.myth}
            fact={featuredMyth.data.fact}
        />
    )}

    {featuredQuote && (
        <QuoteCard
            quote={featuredQuote.data.quote}
            author={featuredQuote.data.author}
        />
    )}

    {featuredVideo && (
        <SignOfTheWeekCard
            media={
                featuredVideo.data.featuredMedia ||
                featuredVideo.data.thumbnail
            }
            mediaType={
                featuredVideo.data.featuredMediaType || "image"
            }
            sign={featuredVideo.data.sign}
            description={featuredVideo.data.description}
            difficulty={featuredVideo.data.difficulty}
        />
    )}

    <NewsLetterCard />

</div>