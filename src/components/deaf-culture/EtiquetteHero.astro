---
import { getCollection } from "astro:content";

const etiquetteGuidelines = await getCollection("etiquette");

const guidelineCount = etiquetteGuidelines.length;

const categories = new Set(
    etiquetteGuidelines.map(
        (item) => item.data.category
    )
);

const categoryCount = categories.size;

const latestDate = etiquetteGuidelines
    .map((item) => item.data.publishedDate)
    .filter(Boolean)
    .sort()
    .reverse()[0];
---


<section class="collection-hero">

    <div class="container">

        <nav class="breadcrumb">

            <a href="/">

                Home

            </a>
            
            <span> > </span>

            <a href="/deaf-culture">

                Deaf Culture 101

            </a>

            <span> > </span>

            <span style="color:black;">

                Communication Etiquette

            </span>

        </nav>

        <div class="page-hero-content">

            <h1>

                Communication Etiquette

            </h1>

            <p>

                A practical guide to respectful interaction, clear communication, and inclusive conversations with Deaf individuals.

            </p>

        </div>

        <div class="page-hero-stats">

            <div class="stat-card">

                <h3>

                    {guidelineCount}

                </h3>

                <p>

                    Guidelines

                </p>

            </div>

            <div class="stat-card">

                <h3>

                    {categoryCount}

                </h3>

                <p>

                    Categories

                </p>

            </div>

            <div class="stat-card">

                <h3>

                    {latestDate ?? "—"}

                </h3>

                <p>

                    Updated

                </p>

            </div>

        </div>

    </div>

</section>