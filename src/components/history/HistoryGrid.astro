---
import { getCollection } from "astro:content";

import ArticleCard from "../shared/ArticleCard.astro";

import EmptyState from "../shared/EmptyState.astro";

const historyArticles = await getCollection(
    "articles",
    ({ data }) => data.category === "History"
);

const sortedHistoryArticles = [...historyArticles].sort(
    (a, b) =>
        b.data.publishedDate.getTime() -
        a.data.publishedDate.getTime()
);
---

<section class="history-grid">

    <div class="container">

        <div class="history-grid">

            {
                sortedHistoryArticles.map((article) => (
                    <ArticleCard
                        image={article.data.featuredImage.src}
                        badge={article.data.topic}
                        category={article.data.topic}
                        author={article.data.author}
                        date={(
                            article.data.updatedDate ??
                            article.data.publishedDate
                        ).toLocaleDateString("en-KE", {
                            month: "short",
                            day: "numeric",
                            year: "numeric",
                        })}
                        title={article.data.title}
                        excerpt={article.data.excerpt}
                        slug={article.id}
                    />
                ))
            }

        </div>

       

        <EmptyState

            title="No history articles found"

            description="We're working on adding more content to this topic. Try another category or view all history articles."

            buttonText="View All Articles"

            buttonAction="reset"

        />

    </div>

</section>