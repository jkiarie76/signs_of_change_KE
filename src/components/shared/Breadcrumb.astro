---
interface Props {

    items: {

        label: string;

        href?: string;

    }[];

}

const { items } = Astro.props;
---

<nav
    class="breadcrumb"
    aria-label="Breadcrumb"
>

    {
        items.map((item, index) => (

            <>

                {

                    item.href ? (

                        <a href={item.href}>

                            {item.label}

                        </a>

                    ) : (

                        <span class="current">

                            {item.label}

                        </span>

                    )

                }

                {

                    index < items.length - 1 && (

                        <span class="separator">

                            &gt;

                        </span>

                    )

                }

            </>

        ))
    }

</nav>