---
import { getCollection } from "astro:content";

const articles = await getCollection("articles");

const featuredStory = articles
    .filter(
        (article) =>
            article.data.category === "Stories" &&
            article.data.featured
    )
    .sort(
        (a, b) =>
            b.data.publishedDate.getTime() -
            a.data.publishedDate.getTime()
    )[0];
---

<section
    id="stories"
    class="deafworld-stories-preview"
>

    <div class="container">

        <div class="section-header">

            <span class="eyebrow">

                STORIES

            </span>

            <h2>

                Reporting from the global Deaf community

            </h2>

        </div>

        <p class="section-intro-text">

            Long-form and short reads from Deaf writers, correspondents and community members.

        </p>

        {featuredStory && (

            <article class="featured-story">

                <div class="featured-story-image">

                    <img
                        src={featuredStory.data.featuredImage.src}
                        alt={featuredStory.data.featuredImage.alt}
                    />

                </div>

                <div class="featured-story-content">

                    <div class="featured-story-tags">

                        <span class="hero-category">

                            {featuredStory.data.topic}

                        </span>

                        <span class="hero-featured-badge">

                            ★ Featured

                        </span>

                    </div>

                    <div class="hero-meta">

                        <span>

                            <i class="fa-solid fa-user"></i>

                            {featuredStory.data.author}

                        </span>

                        <span>

                            <i class="fa-regular fa-calendar"></i>

                            {
                                featuredStory.data.publishedDate.toLocaleDateString(
                                    "en-KE",
                                    {
                                        month: "short",
                                        day: "numeric",
                                        year: "numeric"
                                    }
                                )
                            }

                        </span>

                        <span>

                            <i class="fa-regular fa-clock"></i>

                            {featuredStory.data.readTime} min read

                        </span>

                    </div>

                    <h2>

                        {featuredStory.data.title}

                    </h2>

                    <p>

                        {featuredStory.data.excerpt}

                    </p>

                    <a
                        href={`/deaf-world/stories/${featuredStory.id}`}
                        class="read-more-btn"
                    >

                        Read Full Story →

                    </a>

                </div>

            </article>

        )}

        <div class="history-actions-wrapper">

            <a
                href="/deaf-world/stories"
                class="btn-explore-page"
            >

                Explore Stories →

            </a>

        </div>

    </div>

</section>