---
import "../../styles/deaf-culture.css";

import BaseLayout from "../../layouts/BaseLayout.astro";

import Hero from "../../components/deaf-culture/Hero.astro";
---

<section class="culture-hero">

    <div class="container">

        <div class="hero-content">

            <div class="hero-text">

                <span class="hero-label">

                    START HERE

                </span>

                <h1>

                    Learn to see the world through Deaf culture.

                </h1>

                <p>

                    Discover the traditions, history, etiquette and everyday
                    experiences that shape the Deaf community. Whether you're
                    meeting a Deaf person for the first time or simply curious,
                    this is the best place to begin.

                </p>

                <div class="hero-links">

                    <a href="#etiquette">

                        Etiquette

                    </a>

                    <a href="#history">

                        History & Heritage

                    </a>

                    <a href="#myths">

                        Myths & Facts

                    </a>

                </div>

            </div>

            <div class="hero-image">

                <img
                    src="/public/uploads/home/culture_1.jpg"
                    alt="People communicating using Kenyan Sign Language"
                >

            </div>

        </div>

    </div>

</section>