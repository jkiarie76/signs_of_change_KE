---
import { getCollection } from "astro:content";

const videos = (await getCollection("videos"))
    .sort(
        (a, b) =>
            b.data.publishedDate.valueOf() -
            a.data.publishedDate.valueOf()
    )
    .slice(0, 3);
---


<section id="videos" class="learn-sign-videos">

    <div class="container">

        <div class="videos-section-header">

            <span class="eyebrow">
                02 · VIDEO LESSONS
            </span>

            <h2 class="section-heading">
                Learn sign in motion
            </h2>

            <p class="section-subtext">
                Watch practical lessons from our video library and
                learn how signs, expressions and movement come together
                in real communication.
            </p>

        </div>


        <!-- =========================================
             VIDEO LESSON GRID
             ========================================= -->

        <div class="archive-grid">

            {
                videos.map((video) => (
                    <a
                        href={video.data.youtubeUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="video-teaser-card"
                    >

                        <div class="video-frame-wrapper">

                            <img
                                src={video.data.thumbnail}
                                alt={video.data.title}
                            />

                            <div class="video-frame-overlay">

                                <div class="fake-play-btn">

                                    <i class="fa-solid fa-play"></i>

                                </div>

                            </div>

                        </div>


                        <div class="card-text">

                            <span class="card-meta">

                                {video.data.topic}
                                · Watch on YouTube

                                <i class="fa-solid fa-arrow-up-right-from-square"></i>

                            </span>

                            <h3>
                                {video.data.title}
                            </h3>

                            <p>
                                {video.data.description}
                            </p>

                        </div>

                    </a>
                ))
            }
        
        </div>


        <!-- =========================================
             EXPLORE MORE
             ========================================= -->

        <div class="videos-btn">

            <a href="/learn-sign/videos">
                Explore More Video Lessons
                <span aria-hidden="true">→</span>
            </a>

        </div>

    </div>

</section>