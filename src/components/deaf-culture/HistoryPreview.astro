---
import { getCollection } from "astro:content";
import ArticleCard from "../shared/ArticleCard.astro";

const historyArticles = await getCollection(
    "articles",
    ({ data }) => data.category === "History"
);

const latestHistoryArticles = historyArticles
    .sort(
        (a, b) =>
            b.data.publishedDate.getTime() -
            a.data.publishedDate.getTime()
    )
    .slice(0, 3);
---

<section
    id="history"
    class="deaf-history-section"
>

    <div class="container">

        <div class="section-header">

            <span class="eyebrow">

                02 · HISTORY & HERITAGE

            </span>

            <h2>

                Discover the stories that shaped Deaf history

            </h2>

        </div>

        <p class="section-intro-text">

            From the evolution of Kenyan Sign Language to important movements around the world, explore the people and events that continue to shape Deaf identity today.

        </p>

        <div class="preview-grid">

            {
                latestHistoryArticles.map(article => (

                  <ArticleCard
                        image={article.data.featuredImage.src}
                        badge={article.data.category}
                        category={article.data.category}
                        author={article.data.author}
                        date={article.data.publishedDate.toLocaleDateString("en-US", {
                            month: "short",
                            day: "numeric",
                            year: "numeric"
                        })}
                        title={article.data.title}
                        excerpt={article.data.excerpt}
                        slug={article.id}
                    />  

                ))
            }

        </div>

        <div class="history-actions-wrapper">

            <a
                href="/deaf-culture/history"
                class="btn-explore-page"
            >

                Explore History →

            </a>

        </div>

    </div>

</section>