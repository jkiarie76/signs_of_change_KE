---
import { getEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/connect.css";

const globalSettings = await getEntry(
    "settings",
    "global-settings"
);

if (!globalSettings) {
    throw new Error("global-settings.md was not found.");
}

const hero = globalSettings.data.heroes.connect;
---

<BaseLayout
    title="Connect | Signs Of Change KE"
    description="Connect with Signs Of Change KE, share your story, ask a question, or get involved."
    activePage="connect"
>

    <main class="connect-page">

        <!-- =========================================
             HERO VIDEO SECTION
        ========================================== -->

        <section class="connect-video-hero">

            <div class="connect-video-background">

                <img
                    src={hero.backgroundImage.src}
                    alt={hero.backgroundImage.alt}
                    class="connect-bg-image"
                />

                <div class="connect-video-overlay"></div>

            </div>


            <div class="container connect-video-content">

                <span class="eyebrow-light">

                    {hero.label}

                </span>

                <h1>

                    {hero.title}
                
                </h1>


                <p>

                   {hero.description}

                </p>

                <button
                    type="button"
                    class="welcome-video-button"
                    id="open-welcome-modal"
                >
                    <span class="welcome-play-icon">
                        <i class="fa-solid fa-play"></i>
                    </span>

                    <span>
                        Watch Welcome in Sign Language
                    </span>
                </button>

            </div>

        </section>


        <!-- =========================================
             WELCOME VIDEO MODAL
        ========================================== -->

        <div
            class="video-modal"
            id="welcome-video-modal"
            aria-hidden="true"
        >

            <div
                class="modal-backdrop"
                id="modal-backdrop"
            ></div>


            <div
                class="modal-content"
                role="dialog"
                aria-modal="true"
                aria-labelledby="welcome-video-title"
            >

                <button
                    type="button"
                    class="modal-close-button"
                    id="close-welcome-modal"
                    aria-label="Close welcome video"
                >
                    <i class="fa-solid fa-xmark"></i>
                </button>

                <h2 id="welcome-video-title" class="sr-only">
                    Welcome in Sign Language
                </h2>

                <div class="modal-video-wrapper">

                    <video
                        id="modal-player"
                        controls
                        preload="metadata"
                        poster= {hero.welcomeVideo.poster}
                    >

                        <source
                            src= {hero.welcomeVideo.video}
                            type="video/mp4"
                        />

                        <track
                            src= {hero.welcomeVideo.captions}
                            kind="captions"
                            srclang="en"
                            label="English"
                            default
                        />

                        Your browser does not support the video element.

                    </video>

                </div>

            </div>

        </div>


        <!-- =========================================
             ABOUT ME
        ========================================== -->

        <section class="connect-about-section">

            <div class="container connect-about-grid">

                <div class="connect-about-content">

                    <span class="section-eyebrow">
                        ABOUT ME
                    </span>

                    <h2>
                        Hi, I'm Jeridah — writer, signer, and reluctant explainer.
                    </h2>

                    <p>
                        I grew up in a mixed hearing–Deaf family, learned
                        to sign before I learned to read, and started
                        Signs Of Change KE because most of what the
                        internet said about Deaf people was written by
                        hearing people.
                    </p>

                    <p class="muted-text">
                        I wanted to create a place with room for both.
                    </p>

                    <p class="muted-text">
                        You'll find me in the comments, the newsletter,
                        and — every other Friday — behind the camera for
                        our short video letters.
                    </p>

                </div>


                <div class="connect-about-image">

                    <img
                        src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=1000&q=80"
                        alt="Community writer smiling"
                        loading="lazy"
                    />

                </div>

            </div>

        </section>


        <!-- =========================================
             MISSION
        ========================================== -->

        <section class="connect-mission-section">

            <div class="container">

                <span class="section-eyebrow">
                    MISSION
                </span>

                <h2 class="mission-heading">
                    To tell Deaf stories in the language they deserve —
                    and invite hearing readers in without dumbing anything down.
                </h2>


                <div class="mission-grid">

                    <article class="mission-card">

                        <h3>
                            Language-first
                        </h3>

                        <p>
                            Sign languages are full languages. We write
                            about them that way — with grammar, culture,
                            and history intact.
                        </p>

                    </article>


                    <article class="mission-card">

                        <h3>
                            Access as design
                        </h3>

                        <p>
                            Captions, transcripts, alt text, plain
                            language, and high-contrast type are the
                            baseline — not an add-on.
                        </p>

                    </article>


                    <article class="mission-card">

                        <h3>
                            Community-led
                        </h3>

                        <p>
                            Deaf writers, Deaf editors, Deaf sensitivity
                            readers. Hearing allies are welcomed,
                            never centered.
                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- =========================================
             CONTACT
        ========================================== -->

        <section class="connect-contact-section">

            <div class="container connect-contact-grid">


                <!-- Contact information -->

                <div class="contact-information">

                    <span class="section-eyebrow">
                        SAY HELLO
                    </span>

                    <h2>
                        Contact
                    </h2>

                    <p>
                        Story pitches, corrections, cultural feedback,
                        or just a wave. Every message is read by a human.
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        <a href="tel:+254700000000">
                            0700 000 000
                        </a>
                    </p>

                    <p>
                        <strong>Email:</strong>
                        <a href="mailto:info@signsofchangeke.com">
                            info@signsofchangeke.com
                        </a>
                    </p>


                    <div class="contact-social-links">

                        <a href="#" aria-label="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>

                        <a href="#" aria-label="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>

                        <a href="#" aria-label="X">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>

                        <a href="#" aria-label="TikTok">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>

                        <a href="#" aria-label="Pinterest">
                            <i class="fa-brands fa-pinterest-p"></i>
                        </a>

                        <a href="#" aria-label="WhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>

                        <a href="#" aria-label="YouTube">
                            <i class="fa-brands fa-youtube"></i>
                        </a>

                    </div>

                </div>


                <!-- Contact form -->

                <div class="contact-form-wrapper">

                    <form
                        id="connect-contact-form"
                        class="connect-contact-form"
                        action="https://api.web3forms.com/submit"
                        method="POST"
                    >

                        <!-- Web3Forms access key -->
                        <input
                            type="hidden"
                            name="access_key"
                            value="55eef4d1-147e-44eb-88a8-d48190024fc9"
                        />

                        <input
                            type="hidden"
                            name="subject"
                            value="New message from Signs Of Change KE"
                        />

                        <input
                            type="hidden"
                            name="from_name"
                            value="Signs Of Change KE Website"
                        />


                        <label for="contact-name" class="sr-only">
                            Name
                        </label>

                        <input
                            id="contact-name"
                            type="text"
                            name="name"
                            placeholder="Name"
                            class="contact-input"
                            autocomplete="name"
                            required
                        />


                        <label for="contact-email" class="sr-only">
                            Email
                        </label>

                        <input
                            id="contact-email"
                            type="email"
                            name="email"
                            placeholder="Email"
                            class="contact-input"
                            autocomplete="email"
                            required
                        />


                        <label for="contact-subject" class="sr-only">
                            Subject
                        </label>

                        <input
                            id="contact-subject"
                            type="text"
                            name="subject"
                            placeholder="Subject"
                            class="contact-input"
                            required
                        />


                        <label for="contact-message" class="sr-only">
                            Message
                        </label>

                        <textarea
                            id="contact-message"
                            name="message"
                            placeholder="Message"
                            class="contact-textarea"
                            rows="6"
                            required
                        ></textarea>


                        <div class="form-submit-footer">

                            <span class="reply-guarantee">
                                We reply within 3 business days.
                            </span>

                            <button
                                type="submit"
                                class="form-submit-button"
                            >
                                Send Message
                            </button>

                        </div>


                        <p
                            id="form-result"
                            class="form-result-message"
                            aria-live="polite"
                        ></p>

                    </form>

                </div>

            </div>

        </section>


        <!-- =========================================
             FAQ
        ========================================== -->

        <section class="connect-faq-section">

            <div class="container faq-container">

                <span class="section-eyebrow">
                    FAQ
                </span>

                <h2>
                    Frequently Asked Questions
                </h2>


                <div class="faq-list">


                    <article class="faq-item">

                        <button
                            type="button"
                            class="faq-trigger"
                            aria-expanded="false"
                        >
                            <span>
                                What is Signs Of Change KE?
                            </span>

                            <i class="fa-solid fa-chevron-down"></i>

                        </button>

                        <div class="faq-answer">

                            <p>
                                Signs Of Change KE is an educational
                                platform celebrating Deaf culture,
                                Kenyan Sign Language, community stories,
                                accessibility and digital inclusion.
                            </p>

                        </div>

                    </article>


                    <article class="faq-item">

                        <button
                            type="button"
                            class="faq-trigger"
                            aria-expanded="false"
                        >
                            <span>
                                Is the sign language course free?
                            </span>

                            <i class="fa-solid fa-chevron-down"></i>

                        </button>

                        <div class="faq-answer">

                            <p>
                                Yes. Our basic conversational
                                fingerspelling materials and learning
                                resources are freely available.
                            </p>

                        </div>

                    </article>


                    <article class="faq-item">

                        <button
                            type="button"
                            class="faq-trigger"
                            aria-expanded="false"
                        >
                            <span>
                                How can I contribute?
                            </span>

                            <i class="fa-solid fa-chevron-down"></i>

                        </button>

                        <div class="faq-answer">

                            <p>
                                You can share a story, suggest a
                                community resource, provide cultural
                                feedback, support an advocacy initiative,
                                or simply get in touch through our
                                contact form.
                            </p>

                        </div>

                    </article>


                </div>

            </div>

        </section>



        <!-- =========================================
             BACK TO TOP
        ========================================== -->

        <button
            type="button"
            class="back-to-top"
            id="back-to-top"
            aria-label="Back to top"
        >
            <i class="fa-solid fa-arrow-up"></i>
        </button>

    </main>

</BaseLayout>


<script src="/public/assets/js/connect.js" defer></script>