---
import { getCollection } from "astro:content";
import FlipCard from "../shared/FlipCard.astro";

const myths = (
    await getCollection("myths")
)
    .sort(
        (a, b) =>
            b.data.publishedDate.valueOf() -
            a.data.publishedDate.valueOf()
    )
    .slice(0, 2);
---

<section id="myths" class="section-myths">

    <div class="container">

        <div class="section-header">

            <span class="eyebrow">
                03 · MYTH-BUSTING LIBRARY
            </span>

            <h3>
                Myths, gently corrected
            </h3>

        </div>

        <p class="section-intro-text">
            You don't have to be embarrassed if you believed any of these — most hearing people do.
            What matters is what you do with the correction.
        </p>

        <div class="myths-grid">

            {
                myths.map((item) => (
                    <FlipCard
                        myth={item.data.myth}
                        fact={item.data.fact}
                        category={item.data.category}
                    />
                ))
            }

        </div>

        <div class="btn-bottom">

            <a
                href="/deaf-culture/myths"
                class="btn-myths-facts"
            >
                Explore Myths & Facts →
            </a>

        </div>

    </div>

</section>