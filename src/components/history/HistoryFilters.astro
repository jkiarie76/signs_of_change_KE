---
import { getCollection } from "astro:content";

const historyArticles = await getCollection(
    "articles",
    ({ data }) => data.category === "History"
);

const topicCounts = new Map<string, number>();

historyArticles.forEach((article) => {
    const topic = article.data.topic;

    topicCounts.set(
        topic,
        (topicCounts.get(topic) ?? 0) + 1
    );
});

const filters = [
    {
        label: "All",
        value: "all",
        count: historyArticles.length,
        active: true,
    },

    ...Array.from(topicCounts.entries())
        .sort(([topicA], [topicB]) =>
            topicA.localeCompare(topicB)
        )
        .map(([topic, count]) => ({
            label: topic,
            value: topic,
            count,
        })),
];
---

<section class="history-filters">

    <div class="container">

        <div class="filters-heading">

            <h3>Browse by Topic</h3>

            <p>
                <p>
                    Explore historical milestones by topic.
                </p>
            </p>

        </div>

        <div
            class="filters-wrapper"
            data-filter-group
            data-target=".history-grid"
        >

            {
                filters.map((filter) => (

                   <button
                        class={`history-filter ${
                            filter.value === "all" ? "active" : ""
                        }`}
                        data-filter={filter.value}
                    >

                        <span>

                            {filter.label}

                        </span>

                        <small>

                            {filter.count}

                        </small>

                    </button>

                ))
            }

        </div>

    </div>

</section>