---
import { getCollection } from "astro:content";

const advocacyItems = await getCollection("advocacy");

const publishedAdvocacy = advocacyItems.filter(
    (item) => item.data.published
);

const categories = [
    ...new Set(
        publishedAdvocacy.map(
            (item) => item.data.category
        )
    )
];
---

<div class="container">

    <div
        class="advocacy-filter-section"
        data-filter-group
        data-target=".advocacy-grid"
    >

        <div class="filters-grid">

            <button
                type="button"
                class="filter-chip active"
                data-filter="all"
            >
                All Initiatives
            </button>


            {
                categories.map((category) => (

                    <button
                        type="button"
                        class="filter-chip"
                        data-filter={category}
                    >
                        {category}
                    </button>

                ))
            }

        </div>

    </div>

</div>