---
---

<section
    id="stories"
    class="deafworld-stories-preview"
>

    <div class="container">

        <div class="section-header">

            <span class="eyebrow">

                STORIES

            </span>

            <h2>

                Reporting from the global Deaf community

            </h2>

        </div>

        <p class="section-intro-text">

            Long-form and short reads from Deaf writers, correspondents and community members.

        </p>

        <article class="featured-story">

            <div class="featured-story-image">

                <img
                    src="https://images.unsplash.com/photo-1531545514256-b1400bc00f31?w=800&auto=format&fit=crop&q=80" alt="Community Spotlight Feature"
                />

            </div>

            <div class="featured-story-content">

                <div class="featured-story-tags">

                    <span class="hero-category">

                        Featured Profile

                    </span>

                </div>

                <div class="hero-meta">

                    <span>

                        <i class="fa-solid fa-user"></i>

                        Admin

                    </span>

                    <span>

                        <i class="fa-regular fa-calendar"></i>

                        July 2026

                    </span>

                    <span>

                        <i class="fa-regular fa-clock"></i>

                        6 min read

                    </span>

                </div>

                <h2>

                    Breaking Barriers: How Digital Signage is Transforming Kenyan Workspaces

                </h2>

                <p>

                    An in-depth conversation with local innovators redesigning inclusive accessibility across corporate offices in Nairobi.

                </p>

                <a
                    href="#"
                    class="read-more-btn"
                >

                    Read Full Story →

                </a>

            </div>

        </article>

        <div class="history-actions-wrapper">

            <a
                href="/deaf-world/stories"
                class="btn-explore-page"
            >

                Explore Stories →

            </a>

        </div>

    </div>

</section>