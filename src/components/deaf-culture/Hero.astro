---
import { getEntry } from "astro:content";

const globalSettings = await getEntry(
    "settings",
    "global-settings"
);

if (!globalSettings) {
    throw new Error("global-settings.md was not found.");
}

const hero = globalSettings.data.heroes.deafCulture;
---

<section class="culture-hero">

    <div class="container">

        <div class="hero-content">

            <div class="hero-text">

                <span class="hero-label">

                    {hero.label}

                </span>

                <h1>

                   {hero.title} 

                </h1>

                <p>

                    {hero.description}

                </p>

                <div class="hero-links">

                    <a href="#etiquette">

                        Etiquette

                    </a>

                    <a href="#history">

                        History & Heritage

                    </a>

                    <a href="#myths">

                        Myths & Facts

                    </a>

                </div>

            </div>

            <div class="hero-image">

                <img
                    src={hero.image.src}
                    alt={hero.image.alt}
                >

            </div>

        </div>

    </div>

</section>