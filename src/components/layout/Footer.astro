---
import {
    Facebook,
    Instagram,
    Youtube,
    Mail,
    Phone,
    MapPin
} from "lucide-astro";
---

<footer class="site-footer">

    <div class="container">

        <div class="footer-grid">

            <!-- Brand -->

            <div class="footer-brand">

                <h2>Signs Of Change KE</h2>

                <p>

                    Bridging the communication gap between Deaf and hearing communities through education, storytelling and advocacy.

                </p>

                <div class="footer-socials">

                    <a href="#" aria-label="Facebook">
                        <Facebook size={20}/>
                    </a>

                    <a href="#" aria-label="Instagram">
                        <Instagram size={20}/>
                    </a>

                    <a href="#" aria-label="YouTube">
                        <Youtube size={20}/>
                    </a>

                </div>

            </div>

            <!-- Explore -->

            <div>

                <h4>Explore</h4>

                <ul>

                    <li><a href="/">Home</a></li>

                    <li><a href="/learn-sign">Learn Sign</a></li>

                    <li><a href="/deaf-culture">Deaf Culture</a></li>

                    <li><a href="/deaf-world">Deaf World</a></li>

                </ul>

            </div>

            <!-- Resources -->

            <div>

                <h4>Resources</h4>

                <ul>

                    <li><a href="/about">About</a></li>

                    <li><a href="/privacy">Privacy Policy</a></li>

                    <li><a href="/terms">Terms & Conditions</a></li>

                    <li><a href="/faq">FAQs</a></li>

                </ul>

            </div>

            <!-- Contact -->

            <div>

                <h4>Contact</h4>

                <ul class="footer-contact">

                    <li>

                        <Mail size={16}/>

                        hello@signsofchangeke.org

                    </li>

                    <li>

                        <Phone size={16}/>

                        +254 XXX XXX XXX

                    </li>

                    <li>

                        <MapPin size={16}/>

                        Nairobi, Kenya

                    </li>

                </ul>

            </div>

        </div>

        <div class="footer-bottom">

            <p>

                © 2026 Signs Of Change KE.   "Every sign shared is a bridge built."

            </p>

        </div>

    </div>

</footer>