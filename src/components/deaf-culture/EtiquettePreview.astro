---
import EtiquetteCard from "../shared/EtiquetteCard.astro";

const previewGuidelines: {
    type: "do" | "dont";
    title: string;
    description: string;
}[]  = [

    {
        type: "do",

        title: "Tap the Shoulder Softly",

        description:
            "Gently tap the person once or twice on the shoulder or upper arm. Alternatively, if you are at a distance, emit a small, polite wave within their direct line of sight to signal your presence naturally."
    },

    {
        type: "dont",

        title: "Avoid Aggressive Gestures",

        description:
            "Never poke, touch the face or head, or grab someone's hands to stop them from signing. Avoid throwing objects or waving your hands frantically inches away from their face, as this is highly disruptive."
    }

];
---
<section id="etiquette" class="section-etiquette">
        <div class="container">
            <div class="section-header">
                <span class="eyebrow">01 · ETIQUETTE & SOCIAL NORMS</span>
                <h3>How to interact with respect</h3>
            </div>
            <p class="section-intro-text">Most awkward moments come from good intentions and missing context. These are the norms Deaf readers tell us they wish more hearing people knew — save them, share them.</p>
            
            <div class="etiquette-grid">
                <!-- Rule 1: Gaining Attention (DO) -->
                   {

                        previewGuidelines.map((item) => (

                            <EtiquetteCard {...item} />

                        ))

                    }

            </div>
            
            <div class="btn-center-bottom">
                <a class="btn-etiquette" href="/deaf-culture/etiquette">Explore Deaf Etiquette</a>
            </div>
            
        </div>
    </section>