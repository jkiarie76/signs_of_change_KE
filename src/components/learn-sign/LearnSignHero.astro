---
import { getEntry } from "astro:content";

const globalSettings = await getEntry(
    "settings",
    "global-settings"
);

if (!globalSettings) {
    throw new Error("global-settings.md was not found.");
}

const hero = globalSettings.data.heroes.learnSign;
---

<section class="learn-sign-hero">

    <div class="container learn-sign-hero-grid">

        <div class="learn-sign-hero-content">

            <span class="eyebrow">

                {hero.label}

            </span>

            <h1>
                
                {hero.title}

            </h1>

            <p>
                
                {hero.description}

            </p>

            <div class="learn-sign-hero-actions">

                <a
                    href="#alphabet-section"
                    class="pill-btn"
                >
                    Alphabet & Numbers
                </a>

                <a
                    href="#videos"
                    class="pill-btn"
                >
                    Videos
                </a>

            </div>

        </div>


        <div class="learn-sign-hero-image">

            <img
                src={hero.image.src}
                alt={hero.image.alt}

            >

        </div>

    </div>

</section>