---
import { getEntry } from "astro:content";

const globalSettings = await getEntry(
    "settings",
    "global-settings"
);

if (!globalSettings) {
    throw new Error("global-settings.md was not found.");
}

const hero = globalSettings.data.heroes.deafWorld;
---

<section class="deafworld-hero">

    <div class="container">

        <div class="hero-split-layout">

            <div class="hero-text-side">

                <span class="eyebrow">

                    {hero.label}

                </span>

                <h1>

                    {hero.title}

                </h1>

                <p>

                   {hero.description}

                </p>

                <div class="hero-anchors-row">

                    <a href="#stories" class="chip-btn">
                        Stories
                    </a>

                    <a href="#events" class="chip-btn">
                        Events
                    </a>

                    <a href="#advocacy" class="chip-btn">
                        Advocacy
                    </a>

                </div>

            </div>

            <div class="hero-image-side">

                <img
                    src={hero.image.src}
                    alt={hero.image.alt}
                />

            </div>

        </div>

    </div>

</section>