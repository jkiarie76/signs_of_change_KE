---
import {
    Facebook,
    Instagram,
    Youtube
} from "lucide-astro";
---

<div class="floating-socials">

    <a
        href="#"
        aria-label="Facebook"
    >
        <Facebook size={20}/>
    </a>

    <a
        href="#"
        aria-label="Instagram"
    >
        <Instagram size={20}/>
    </a>

    <a
        href="#"
        aria-label="YouTube"
    >
        <Youtube size={20}/>
    </a>

   

</div>