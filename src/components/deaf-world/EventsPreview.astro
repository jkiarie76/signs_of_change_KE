---
import { getCollection } from "astro:content";

const events = await getCollection("events");

const upcomingEvents = events
    .filter((event) =>
        event.data.published &&
        event.data.eventDate >= new Date()
    )
    .sort(
        (a, b) =>
            a.data.eventDate.getTime() -
            b.data.eventDate.getTime()
    );

const featuredEvent =
    upcomingEvents.find(
        (event) => event.data.featured
    ) ?? upcomingEvents[0];
---

<section
    id="events"
    class="deafworld-events-preview"
>

    <div class="container">

        <div class="section-header">

            <span class="eyebrow">

                EVENTS

            </span>

            <h2>

                What's happening across the Deaf world

            </h2>

        </div>

        <p class="section-intro-text">

            Conferences, workshops, festivals and community gatherings happening around the country.

        </p>

        {featuredEvent && (
            <article class="featured-event-card">

                <div class="event-image">

                    <img
                        src={featuredEvent.data.featuredImage.src}
                        alt={featuredEvent.data.featuredImage.alt}
                    />

                    <div class="event-date">

                        <span class="month">
                            {featuredEvent.data.eventDate.toLocaleDateString(
                                "en-KE",
                                { month: "short" }
                            ).toUpperCase()}
                        </span>

                        <span class="day">
                            {featuredEvent.data.eventDate.toLocaleDateString(
                                "en-KE",
                                { day: "numeric" }
                            )}
                        </span>

                    </div>

                </div>


                <div class="event-content">

                    <div class="event-meta">

                        <span>

                            <i class="fa-solid fa-building"></i>

                            Organized by {featuredEvent.data.organizer}

                        </span>

                        <span>

                            <i class="fa-regular fa-clock"></i>

                            {featuredEvent.data.startTime}
                            -
                            {featuredEvent.data.endTime}

                        </span>

                        <span class="location">

                            <i class="fa-solid fa-location-dot"></i>

                            {featuredEvent.data.location}

                        </span>

                    </div>


                    <h3>

                        {featuredEvent.data.title}

                    </h3>


                    <p>

                        {featuredEvent.data.excerpt}

                    </p>


                    <div class="featured-event-actions">

                        <a
                            href={`/deaf-world/events/${featuredEvent.id}`}
                            class="event-view-btn"
                        >
                            View Event
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                        {
                            featuredEvent.data.registrationUrl && (

                                <a
                                    href={featuredEvent.data.registrationUrl}
                                    class="event-register-btn"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {featuredEvent.data.registrationLabel}
                                </a>

                            )
                        }

                    </div>
                    


                </div>

            </article>    
        )}

        {!featuredEvent && (
            <div class="events-empty-state">

                <h3>
                    No upcoming events yet
                </h3>

                <p>
                    We're keeping an eye out for conferences, workshops,
                    festivals and community gatherings happening across
                    the Deaf world.
                </p>

                <a
                    href="/connect"
                    class="btn-secondary"
                >
                    Submit an Event →
                </a>

            </div>
        )}

        <div class="events-footer">

            <div class="events-message">

                <strong>

                    Running an event?

                </strong>

                <p>

                    Submit your event for review and help more people discover it.

                </p>

            </div>

            <div class="events-actions">

                <a
                    href="/connect"
                    class="btn-secondary"
                >

                    Submit Event

                </a>

                <a
                    href="/deaf-world/events"
                    class="btn-primary"
                >

                    Explore Events →

                </a>

            </div>

        </div>

    </div>

</section>