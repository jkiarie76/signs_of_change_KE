---
interface Props {

    eyebrow?: string;

    title: string;

    description?: string;

    align?: "left" | "center";

}

const{

    eyebrow,

    title,

    description,

    align="center"

}=Astro.props;
---

<div class={`section-header ${align}`}>

    {eyebrow && (

        <span class="section-eyebrow">

            {eyebrow}

        </span>

    )}

    <h2>

        {title}

    </h2>

    {description && (

        <p>

            {description}

        </p>

    )}

</div>