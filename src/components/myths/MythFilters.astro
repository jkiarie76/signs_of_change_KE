---
import { getCollection } from "astro:content";

const myths = await getCollection("myths");

const categories = [
    ...new Set(
        myths
            .map((myth) => myth.data.category)
            .filter(Boolean)
    )
].sort();
---

<section class="myth-filters">

    <div class="container">

        <div class="filters-heading">

            <h3>

                Browse by Topic

            </h3>

            <p>

                Explore common misconceptions by category.

            </p>

        </div>

        <div class="filters-wrapper">

            <div 
        
                class="filters-grid"

                data-filter-group

                data-target=".myths-grid"

            >

                <button
                    class="history-filter active"
                    data-filter="all"
                >
                    All
                </button>

                {
                    categories.map((category) => (
                        <button
                            class="history-filter"
                            data-filter={category}
                        >
                            {category}
                        </button>
                    ))
                }
                
            </div>    

        </div>

    </div>

</section>