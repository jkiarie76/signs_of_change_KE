---
import { getCollection } from "astro:content";

const historyArticles = await getCollection(
    "articles",
    ({ data }) => data.category === "History"
);

const articleCount = historyArticles.length;

const topics = new Set(
    historyArticles.map((article) => article.data.topic)
);

const topicCount = topics.size;

const latestHistoryArticle = [...historyArticles].sort((a, b) => {
    const dateA =
        a.data.updatedDate ??
        a.data.publishedDate;

    const dateB =
        b.data.updatedDate ??
        b.data.publishedDate;

    return dateB.getTime() - dateA.getTime();
})[0];

const latestUpdateDate = latestHistoryArticle
    ? (
        latestHistoryArticle.data.updatedDate ??
        latestHistoryArticle.data.publishedDate
      ).toLocaleDateString("en-KE", {
        month: "short",
        day: "numeric",
        year: "numeric",
      })
    : "No updates yet";
---


<section class="collection-hero">

    <div class="container">

        <nav class="breadcrumb">

            <a href="/">

                Home

            </a>
            
            <span> > </span>

            <a href="/deaf-culture">

                Deaf Culture 101

            </a>

            <span> > </span>

            <span style="color:black;">

                Historical milestone

            </span>

        </nav>

        <div class="page-hero-content">

            <h1>

                Historical Milestones

            </h1>

            <p class="history-description">

                Explore the people, movements and defining moments
                that shaped Deaf culture around the world and in Kenya.

            </p>

        </div>    

        <div class="page-hero-stats">

            <div class="stat-card">

                <h3>

                    {articleCount}

                </h3>

                <p>

                    Articles

                </p>

            </div>

            <div class="stat-card">

                <h3>

                  {topicCount}  

                </h3>

                <p>

                    Topics

                </p>

            </div>

            <div class="stat-card">

                <h3>

                    {latestUpdateDate}

                </h3>

                <p>

                    Updated

                </p>

            </div>
            
        </div>

    </div>

</section>