---
---

<section
    id="events"
    class="deafworld-events-preview"
>

    <div class="container">

        <div class="section-header">

            <span class="eyebrow">

                EVENTS

            </span>

            <h2>

                What's happening across the Deaf world

            </h2>

        </div>

        <p class="section-intro-text">

            Conferences, workshops, festivals and community gatherings happening around the country.

        </p>

        <article class="featured-event-card">

            <div class="event-image">

                <img
                    src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=600&auto=format&fit=crop&q=70" alt="Sign Language Meetup"
                    alt="Featured Event"
                />

                <div class="event-date">

                    <span class="month">

                        AUG

                    </span>

                    <span class="day">

                        12

                    </span>

                </div>

            </div>

            <div class="event-content">

                <div class="event-meta">

                    <span>

                        <i class="fa-solid fa-building"></i>

                         Organized by KNAD

                    </span>

                    <span>

                        <i class="fa-regular fa-clock"></i>

                        2:00 PM - 5:00 PM

                    </span>

                    <span class="location">

                        <i class="fa-solid fa-location-dot"></i>

                        Nairobi

                    </span>

                </div>

                <h3>

                    Kenyan Sign Language Weekend Workshop

                </h3>

                <p>

                    Join interpreters, educators and members of the Deaf community for a practical workshop focused on communication and accessibility.

                </p>

                <a
                    href="#"
                    class="btn-primary"
                >

                    Register →

                </a>

            </div>

        </article>

        <div class="events-footer">

            <div class="events-message">

                <strong>

                    Running an event?

                </strong>

                <p>

                    Submit your event for review and help more people discover it.

                </p>

            </div>

            <div class="events-actions">

                <a
                    href="/connect"
                    class="btn-secondary"
                >

                    Submit Event

                </a>

                <a
                    href="/deaf-world/events"
                    class="btn-primary"
                >

                    Explore Events →

                </a>

            </div>

        </div>

    </div>

</section>