---
import { getCollection } from "astro:content";
import EtiquetteCard from "../shared/EtiquetteCard.astro";
import EmptyState from "../shared/EmptyState.astro";

const etiquetteGuidelines = await getCollection("etiquette");
---

<section class="etiquette-grid-section">

    <div class="container">

        <div class="etiquette-page-grid">

            {

                etiquetteGuidelines.map((item) => (
                    <EtiquetteCard
                        type={item.data.type}
                        category={item.data.category}
                        title={item.data.title}
                        description={item.data.description}
                    />

                ))

            }

        </div>

        <EmptyState
            title="No etiquette guidance found"
            description="We're still adding guidance for this situation. Try another category or view all guidance."
            buttonText="View All Guidance"
            buttonAction="reset"
        />

    </div>

</section>