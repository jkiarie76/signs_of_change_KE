---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/deaf-world.css";
---

<BaseLayout
    title="Stories | Deaf World | Signs Of Change KE"
    description="Stories, perspectives and reporting from Deaf communities across Kenya and around the world."
    activePage="world"
>

    <main class="deaf-world-stories-page">

        <!-- BREADCRUMB -->
        <section class="stories-header">

            <div class="container">

                <nav class="breadcrumb-nav">

                    <a href="/">
                        Home
                    </a>

                    <span>›</span>

                    <a href="/deaf-world">
                        Deaf World
                    </a>

                    <span>›</span>

                    <span class="current-page">
                        Stories
                    </span>

                </nav>

            </div>

        </section>


        <!-- FEATURED STORY -->
        <section class="stories-featured-section">

            <div class="container">

                <article class="featured-story-hero">

                    <div class="hero-image-pane">

                        <img
                            src="https://images.unsplash.com/photo-1531545514256-b1400bc00f31?w=800&auto=format&fit=crop&q=80"
                            alt="Community members collaborating around a laptop"
                        />

                        <span class="story-badge hero-badge">

                            Featured Profile

                        </span>

                    </div>


                    <div class="hero-content-pane">

                        <div class="story-meta-row">

                            <span class="story-author">

                                <i class="fa-regular fa-user"></i>

                                By Signs of Change KE Editorial
                                
                            </span>

                            <span class="story-read-time">

                                <i class="fa-regular fa-clock"></i>

                                6 min read

                            </span>

                            <span class="story-date">

                                July 2026

                            </span>

                        </div>


                        <h1 class="hero-title">

                            Breaking Barriers: How Digital Signage is Transforming Kenyan Workspaces

                        </h1>


                        <p class="hero-excerpt">

                            An in-depth conversation with local tech advocates redesigning inclusive accessibility matrices across corporate offices in Nairobi.

                        </p>


                        <a
                            href="/stories/workspace-transformation"
                            class="story-read-link"
                        >

                            Read Full Story

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                </article>

            </div>

        </section>


        <!-- STORIES FEED -->
        <section class="stories-feed-section">

            <div class="container">

                <div class="stories-feed-grid">


                    <!-- STORY CARD 1 -->

                    <article class="story-editorial-card">

                        <div class="story-card-image">

                            <img
                                src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=500&auto=format&fit=crop&q=70"
                                alt="Deaf woman smiling"
                            />

                        </div>


                        <div class="story-card-body">

                            <div class="story-meta-row">

                                <span class="story-badge">

                                    Culture

                                </span>

                                <span class="story-author">

                                    <i class="fa-regular fa-user"></i>

                                    Amina Wanjiku

                                </span>

                                <span class="story-read-time">

                                    4 min read

                                </span>

                            </div>


                            <h2 class="story-card-title">

                                The Nuances of Facial Expressions in Native Syntax

                            </h2>


                            <p class="story-card-excerpt">

                                Why physical eyebrow shifts and spatial placement carry more grammatical weight than hand formations alone.

                            </p>


                            <a
                                href="#"
                                class="story-text-link"
                            >

                                Read Article

                            </a>

                        </div>

                    </article>


                    <!-- STORY CARD 2 -->

                    <article class="story-editorial-card">

                        <div class="story-card-image">

                            <img
                                src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=500&auto=format&fit=crop&q=70"
                                alt="People collaborating around a laptop"
                            />

                        </div>


                        <div class="story-card-body">

                            <div class="story-meta-row">

                                <span class="story-badge">

                                    Community

                                </span>

                                <span class="story-author">

                                    <i class="fa-regular fa-user"></i>

                                    Daniel Mwangi

                                </span>

                                <span class="story-read-time">

                                    3 min read

                                </span>

                            </div>


                            <h2 class="story-card-title">

                                From Student to Interpreter: A Journey of Connection

                            </h2>


                            <p class="story-card-excerpt">

                                How regular practice sequences enabled a web developer to build bridges in local community hubs.

                            </p>


                            <a
                                href="#"
                                class="story-text-link"
                            >

                                Read Article

                            </a>

                        </div>

                    </article>


                </div>

            </div>

        </section>

    </main>

</BaseLayout>