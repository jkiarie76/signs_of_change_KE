---
import { getCollection } from "astro:content";

const settings = await getCollection("settings");

const globalSettings = settings[0];
---

<div class="homepage-newsletter-card">

    <div class="newsletter-icon">

        <i class="fa-regular fa-envelope"></i>

    </div>

    <h3>

        {globalSettings.data.newsletter.title}

    </h3>

    <p>

        {globalSettings.data.newsletter.description}

    </p>

    <form class="newsletter-form">

        <input
            type="email"
            placeholder="Enter your email"
        />

        <button type="submit">

            {globalSettings.data.newsletter.buttonText}
            <i class="fa-solid fa-arrow-right"></i>

        </button>

    </form>

    <small>

        {globalSettings.data.newsletter.privacyText}

    </small>

</div>