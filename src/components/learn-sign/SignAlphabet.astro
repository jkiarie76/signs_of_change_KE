<section id="alphabet-section" class="learn-sign-alphabet">

    <div class="container">

        <span class="eyebrow">
            01 · INTERACTIVE
        </span>

        <h2 class="section-heading">
            Alphabet & Numbers
        </h2>

        <p class="section-subtext">
            Tap any letter or number to see how the handshape is formed.
            This is fingerspelling — the backbone you fall back on for
            names, brands, and any word you don't yet know the sign for.
        </p>


        <div class="interactive-alphabet-grid">


            <!-- =========================================
                 LEFT — CHARACTER SELECTOR
                 ========================================= -->

            <div class="alphabet-selector">

                <div class="toggle-container">

                    <button
                        type="button"
                        id="toggle-az"
                        class="toggle-btn active"
                        data-character-mode="letters"
                    >
                        A–Z
                    </button>

                    <button
                        type="button"
                        id="toggle-09"
                        class="toggle-btn"
                        data-character-mode="numbers"
                    >
                        0–10
                    </button>

                </div>


                <div
                    id="character-buttons-grid"
                    class="buttons-layout-grid"
                >

                    <!-- JavaScript generates the characters here -->

                </div>

            </div>


            <!-- =========================================
                 RIGHT — SIGN PREVIEW
                 ========================================= -->

            <article
                class="preview-card"
                id="preview-card"
            >

                <span class="preview-eyebrow">
                    FINGERSPELLING
                </span>


                <div class="preview-display-row">

                    <div
                        class="preview-box-avatar"
                        id="preview-avatar"
                    >
                        A
                    </div>


                    <div class="preview-text-details">

                        <h3
                            class="preview-title"
                            id="preview-title"
                        >
                            Sign for "A"
                        </h3>

                        <p
                            class="preview-desc"
                            id="preview-desc"
                        >
                            Closed fist, thumb rests along the side.
                        </p>

                    </div>

                </div>


                <ul
                    class="preview-tips-list"
                    id="preview-tips"
                >

                    <li>
                        Keep your dominant hand in a comfortable
                        signing space near your shoulder.
                    </li>

                    <li>
                        Palm usually faces the person you're signing to.
                    </li>

                    <li>
                        Pause briefly between numbers and letters —
                        don't rush.
                    </li>

                </ul>

            </article>

        </div>

    </div>

</section>