---
interface Props {
    initiative: any;
    preview?: boolean;
}

const {
    initiative,
    preview = false
} = Astro.props;

const data = initiative.data;


/* =========================================
   CAMPAIGN TYPE
========================================= */

const campaignType =
    data.type === "campaign"
        ? "campaign"
        : data.type === "initiative"
            ? "initiative"
            : "resource";


/* =========================================
   ICON
========================================= */

const icon =
    data.type === "campaign"
        ? "fa-solid fa-gavel"
        : data.type === "resource"
            ? "fa-solid fa-scale-balanced"
            : "fa-solid fa-box-open";


/* =========================================
   STATUS ICON
========================================= */

const statusIcon =
    data.type === "campaign"
        ? "fa-regular fa-calendar"
        : data.type === "resource"
            ? "fa-solid fa-circle-check"
            : "fa-solid fa-circle-info";


/* =========================================
   DETAIL PAGE URL
========================================= */

const detailUrl =
    `/deaf-world/advocacy/${initiative.id}`;
---

<article
    class:list={[
        "advocacy-card",
        `advocacy-${campaignType}`,
        preview && "advocacy-card-preview"
    ]}
    data-category={data.category}
>

    <div class="advocacy-card-interior">


        <!-- =================================
             CARD META
        ================================== -->

        <div class="advocacy-meta-header">

            <span
                class:list={[
                    "status-badge",
                    `${campaignType}-badge`
                ]}
            >

                <i class={icon}></i>

                {data.category}

            </span>


            <span class="urgency-timeline">

                <i class={statusIcon}></i>

                {
                    data.type === "campaign"
                        ? "Active Drive"
                        : data.type === "resource"
                            ? "Verified Resource"
                            : "Ongoing Initiative"
                }

            </span>

        </div>


        <!-- =================================
             TITLE
        ================================== -->

        <h3 class="advocacy-card-title">

            {data.title}

        </h3>


        <!-- =================================
             DESCRIPTION
        ================================== -->

        <p class="advocacy-card-excerpt">

            {data.excerpt}

        </p>


        <!-- =================================
             CAMPAIGN PROGRESS
        ================================== -->

        {
            data.type === "campaign" &&
            data.progress !== undefined && (

                <div
                    class="progress-bar-container"
                    data-progress-container
                >

                    <div class="progress-label-row">

                        <span class="progress-label">

                            Campaign Progress

                        </span>


                        <span
                            class="progress-value"
                            data-progress-value
                        >

                            0%

                        </span>

                    </div>


                    <div class="progress-track">

                        <div
                            class="progress-fill"
                            data-progress={data.progress}
                        ></div>

                    </div>

                </div>

            )
        }


        <!-- =================================
             VIEW INITIATIVE
        ================================== -->

        <div class="advocacy-footer-zone">

            <a
                href={detailUrl}
                class:list={[
                    "advocacy-action-btn",
                    `${campaignType}-action-btn`
                ]}
            >

                {preview ? "Learn More" : "View Initiative"}

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>

    </div>

</article>