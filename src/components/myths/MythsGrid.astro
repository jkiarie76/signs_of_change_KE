---
import { getCollection } from "astro:content";

import MythCard from "../shared/MythCard.astro";
import EmptyState from "../shared/EmptyState.astro";

const myths = await getCollection("myths");
---

<section class="myths-grid">

    <div class="container">

        <div class="myths-grid">

            {
                myths.map((item) => (
                    <MythCard
                        myth={item.data.myth}
                        fact={item.data.fact}
                        category={item.data.category.toLowerCase()}
                    />
                ))
            }

        </div>

        <EmptyState

            title="No myths found"

            description="We're still researching and adding myths for this topic."

            buttonText="View All Myths"

            buttonAction="reset"

            class="hidden"

        />

    </div>

</section>

