---
interface Props {

    title?: string;

    description?: string;

    buttonText?: string;

    buttonHref?: string;

}

const {

title="Nothing here yet",

description="Check back soon for new content.",

buttonText,

buttonHref

}=Astro.props;
---

<section class="empty-state">

    <div class="empty-icon">

        <i class="fa-regular fa-folder-open"></i>

    </div>

    <h2>

        {title}

    </h2>

    <p>

        {description}

    </p>

    {

        buttonText && buttonHref && (

            <a

                href={buttonHref}

                class="btn btn-primary"

            >

                {buttonText}

            </a>

        )

    }

</section>