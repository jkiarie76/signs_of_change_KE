---
import { getEntry, getCollection } from "astro:content";
import EtiquetteCard from "../shared/EtiquetteCard.astro";

const globalSettings = await getEntry(
    "settings",
    "global-settings"
);

if (!globalSettings) {
    throw new Error("global-settings.md was not found.");
}

const etiquetteSettings =
    globalSettings.data.deafCultureSections.etiquette;

const etiquette = await getCollection("etiquette");

const sortedEtiquette = etiquette.sort(
    (a, b) =>
        b.data.publishedDate.getTime() -
        a.data.publishedDate.getTime()
);

const categories = [
    ...new Set(
        sortedEtiquette.map(
            (item) => item.data.category
        )
    ),
];

const latestCompleteCategory = categories.find(
    (category) => {
        const items = sortedEtiquette.filter(
            (item) =>
                item.data.category === category
        );

        return (
            items.some(
                (item) => item.data.type === "do"
            ) &&
            items.some(
                (item) => item.data.type === "dont"
            )
        );
    }
);

const latestCategoryItems = latestCompleteCategory
    ? sortedEtiquette.filter(
          (item) =>
              item.data.category ===
              latestCompleteCategory
      )
    : [];

const doItem = latestCategoryItems.find(
    (item) => item.data.type === "do"
);

const dontItem = latestCategoryItems.find(
    (item) => item.data.type === "dont"
);

const previewGuidelines =
    doItem && dontItem
        ? [doItem, dontItem]
        : [];

---

<section id="etiquette" class="section-etiquette">
        <div class="container">
            <div class="section-header">
                <span class="eyebrow">
                    
                    {etiquetteSettings.eyebrow}
                    
                </span>
                <h3>
                    
                    {etiquetteSettings.title}
                    
                </h3>
            </div>
            <p class="section-intro-text">
                
                {etiquetteSettings.intro}
            
            </p>
            
            <div class="etiquette-grid">
                <!-- Rule 1: Gaining Attention (DO) -->
                   {
                        previewGuidelines.map((item) => (
                            <EtiquetteCard
                                type={item.data.type}
                                title={item.data.title}
                                description={item.data.description}
                                category={item.data.category}
                            />
                        ))
                    }

            </div>
            
            <div class="btn-center-bottom">
                <a class="btn-etiquette" href="/deaf-culture/etiquette">Explore Deaf Etiquette</a>
            </div>
            
        </div>
    </section>